# MedGemma API Keys Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit your actual .env file to git!
#
# Hardware-specific vars (VLLM_ENV, VLLM_MODEL) live in .env.<hardware>
# and are safe to commit.  Only secrets go in this file.

# ── Secrets (required) ────────────────────────────────────────────────────────

# HuggingFace Token — required for gated MedGemma model access
# Accept the license at https://huggingface.co/google/medgemma-1.5-4b-it first
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# OpenAI API Key — required for Mem0 patient memory
# Used for fact extraction and embeddings
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Hardware vars (override here only for bare-metal / non-Docker runs) ───────
# When using Docker, set these via the matching .env.<hardware> file instead.
#
# Profile choices: local | l4 | a100 | multi_gpu | 4xl4
# VLLM_ENV=local
#
# Model choices:
#   4B (local / L4):   google/medgemma-1.5-4b-it
#   27B (A100 / 4xL4): google/medgemma-27b-it
# VLLM_MODEL=google/medgemma-1.5-4b-it
